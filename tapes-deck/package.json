{
  "name": "tapes-deck",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev-netlify": "netlify-dev/netlify-dev-setup.sh && npm run dev-netlify:serve",
    "dev-netlify:fresh": "netlify-dev/netlify-dev-setup.sh -f && npm run dev-netlify:serve",
    "dev-netlify:serve": "cd netlify-dev && npx netlify dev",
    "dev": "vite --port 5555",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "dedent": "^1.7.2",
    "framer-motion": "^12.35.1",
    "luxon": "^3.7.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/luxon": "^3.7.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "netlify-cli": "^27.10.2",
    "node-addon-api": "^8.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.2.2"
  },
  "allowScripts": {
    "@swc/core@1.16.13": true,
    "@netlify/esbuild@0.13.13": true,
    "netlify-cli@27.10.2": true,
    "esbuild@0.28.1": true,
    "unix-dgram@2.0.7": true,
    "sharp@0.34.5": true,
    "fsevents@2.3.3": true
  }
}

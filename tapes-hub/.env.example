# Copy this file to .env in the same directory (tapes-hub/) and adjust as needed.
# .env is gitignored; this template is tracked so a fresh clone knows the keys.
#
# Docker Compose reads .env automatically because it sits next to compose.yaml.
# Spring picks it up via the spring.config.import entry in application-dev.yaml.

# Dev database (compose.yaml). Changing these after the volume exists requires
# `docker compose -f tapes-hub/compose.yaml down -v` to re-initialise Postgres.
POSTGRES_DB=tapeshub
POSTGRES_USER=tapeshub
POSTGRES_PASSWORD=tapeshub

# Spring Security in-memory dev user (application-dev.yaml).
DEV_USER_NAME=dev
DEV_USER_PASSWORD=dev
